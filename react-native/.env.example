# SeekAR Demo environment. Copy to `.env` and fill in real values.
# Expo automatically loads `.env` at build time (read in app.config.ts).

# SeekAR REST API base URL. Defaults to production.
API_URL=https://www.seekar.io/api

# SeekAR license key (a JWT) — baked into the build. At startup the SDK presents
# it to the license server as a Bearer token to confirm validity + subscription
# (spec §5.1). Mint a dev key from the license server admin endpoint:
#   curl -s https://license-dev.seekar.io/v1/keys/issue \
#     -H "X-Admin-Token: <admin>" -H 'content-type: application/json' \
#     -d '{"licensee":"seekar-demo","products":["rn"],"ttl_days":365}'
SEEKAR_LICENSE_KEY=

# License server base URL. Dev (AKS): https://license-dev.seekar.io
# Prod: https://license.seekar.io  (the SDK appends /v1/checkin)
LICENSE_SERVER_URL=https://license-dev.seekar.io

# Offline-only fallback: point at an echo mock + enable mock mode (any 2xx =
# approved). Leave unset/false to use the real server above.
# LICENSE_CHECKIN_URL=
LICENSE_MOCK=false
# Local stub alternative (seekar-sdk `npm run license-stub`):
# LICENSE_SERVER_URL=http://<your-LAN-ip>:8787

# NOTE: No ReactVision keys here. The SeekAR SDK encapsulates ReactVision Viro
# (including its credentials and native build config) via its Expo config
# plugin — see the @nexrage/react-native plugin in app.config.ts.

# Map debug overlay: draw the green/amber collect-radius circles around each
# collectible. true/1/yes/on to enable, anything else (or unset) disables.
SHOW_RADIUS_CIRCLES=true
